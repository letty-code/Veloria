{
  "buildCommand": "npm run build",
  "outputDirectory": "Frontend/dist",
  "rewrites": [
    {
      "source": "/",
      "destination": "/index.html"
    },
    {
      "source": "/about.html",
      "destination": "/about.html"
    },
    {
      "source": "/account.html",
      "destination": "/account.html"
    },
    {
      "source": "/cart.html",
      "destination": "/cart.html"
    },
    {
      "source": "/checkout.html",
      "destination": "/checkout.html"
    },
    {
      "source": "/confirmation.html",
      "destination": "/confirmation.html"
    },
    {
      "source": "/contact.html",
      "destination": "/contact.html"
    },
    {
      "source": "/Accessories.html",
      "destination": "/collection pages/Accessories.html"
    },
    {
      "source": "/Bags.html",
      "destination": "/collection pages/Bags.html"
    },
    {
      "source": "/Dresses.html",
      "destination": "/collection pages/Dresses.html"
    },
    {
      "source": "/Shoes.html",
      "destination": "/collection pages/Shoes.html"
    }
  ]
}